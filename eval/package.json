{
  "name": "@thereader/extract-eval",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Quality and speed evaluation of @thereader/extract against Readability, Defuddle, Trafilatura and Postlight.",
  "scripts": {
    "snapshot": "bun run scripts/snapshot.ts",
    "validate": "bun run scripts/validate.ts",
    "eval": "bun run scripts/eval.ts",
    "report": "bun run scripts/report.ts",
    "failures": "bun run scripts/failures.ts",
    "dump": "bun run scripts/dump.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@postlight/parser": "2.2.3",
    "defuddle": "0.19.4",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "5.6.3"
  }
}
