{
  "name": "@thereader/truffle-eval",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Quality and speed evaluation of truffle against Readability, Defuddle, Trafilatura and Postlight.",
  "scripts": {
    "snapshot": "bun run scripts/snapshot.ts",
    "validate": "bun run scripts/validate.ts",
    "eval": "bun run scripts/eval.ts",
    "report": "bun run scripts/report.ts",
    "failures": "bun run scripts/failures.ts",
    "dump": "bun run scripts/dump.ts",
    "markdown-cost": "bun run scripts/markdown-cost.ts",
    "bench": "bun run scripts/bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@postlight/parser": "2.2.3",
    "defuddle": "0.19.4",
    "hast-util-to-html": "9.0.5",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-hast": "13.2.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "playwright": "1.63.0",
    "truffle": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "5.6.3"
  }
}
