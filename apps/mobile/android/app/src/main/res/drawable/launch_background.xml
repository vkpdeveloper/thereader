<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window shown until Flutter's first frame: exact black with the
     brand mark centred. No white, no animation, no delay. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:drawable="@drawable/splash_mark"
        android:gravity="center" />
</layer-list>
