{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thereader-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "thereader-books-example"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thereader-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "env": {
    "production": {
      "name": "thereader-api",
      "account_id": "ed59abf53bf57001191058534ff8634d",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "reader.ordinity.com", "custom_domain": true }
      ],
      "r2_buckets": [
        { "binding": "BOOKS", "bucket_name": "thereader-books" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "thereader-state",
          "database_id": "aa9b03e1-4efc-466a-b2a3-6fc23edf016b",
          "migrations_dir": "migrations"
        }
      ],
      "observability": { "enabled": true },
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/v1/*", "/health"]
      }
    }
  }
}
