          "type": "text",
          "text": "A double stores a sign, an exponent and a significand, and the value it represents is"
        }
      ]
    },
    {
      "type": "math",
      "text": "\\text{sign} \\times 2^{\\text{exponent}} \\left(1 + \\frac{\\text{significand}}{2^{52}}\\right)",
      "tex": "\\text{sign} \\times 2^{\\text{exponent}} \\left(1 + \\frac{\\text{significand}}{2^{52}}\\right)"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Adding "
        },
        {
          "type": "math",
          "tex": "x",
          "text": "x"
        },
        {
          "type": "text",
          "text": " and "
        },
        {
          "type": "math",
          "tex": "y",
          "text": "y"
        },
        {
          "type": "text",
          "text": " rounds the exact sum to the nearest representable value, so the error of each step is at most "
        },
        {
          "type": "math",
          "tex": "\\epsilon |x + y|",
          "text": "\\epsilon |x + y|"
        },
        {
          "type": "text",
          "text": " where "
        },
