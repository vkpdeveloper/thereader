          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Just booked the Paris to Berlin sleeper. Ten hours, one bunk, zero airports. Can not wait."
            }
          ]
        }
      ]
    },
    {
      "type": "video",
      "provider": "file",
      "url": "https://travel.example.org/media/clip.mp4",
