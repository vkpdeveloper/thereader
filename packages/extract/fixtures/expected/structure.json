      "content": [
        {
          "type": "text",
          "text": "Readers care about structure even when they never think about it. Lists, tables and notes carry meaning that a wall of text cannot, so an extractor has to keep them intact."
        },
        {
          "type": "ref",
          "id": "fn1",
          "label": "1"
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Lists"
        }
      ]
    },
    {
      "type": "list",
      "ordered": true,
      "start": 3,
      "items": [
        {
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Third step: measure twice."
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Fourth step: cut once."
                }
              ]
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Use a sharp blade."
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Mind your fingers."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "ordered": false,
