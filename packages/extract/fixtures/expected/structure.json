          "marks": [
            "sup"
          ]
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "text",
          "text": "highlights",
          "marks": [
            "highlight"
          ]
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "text",
          "text": "mistakes",
          "marks": [
            "strike"
          ]
        },
        {
