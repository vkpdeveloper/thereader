        {
          "type": "text",
          "text": "Definitions"
        }
      ]
    },
    {
      "type": "definitions",
      "items": [
        {
          "term": [
            {
              "type": "text",
              "text": "Boilerplate"
            }
          ],
          "details": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Navigation, ads and footers that repeat on every page."
                }
              ]
            }
          ]
        },
        {
          "term": [
            {
              "type": "text",
              "text": "Main content"
            }
          ],
          "details": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The text the page exists to deliver."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "details",
      "summary": [
        {
          "type": "text",
          "text": "Why not just use the largest block of text?"
        }
      ],
      "blocks": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Because comment sections and footers are often longer than the article itself, and because articles split across several containers."
            }
          ]
        }
      ]
    },
    {
      "type": "callout",
      "variant": "warning",
      "title": [
        {
          "type": "text",
          "text": "Warning"
        }
      ],
      "blocks": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Layout tables are not data tables. Treat them as containers, never as grids."
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "This paragraph lives inside a layout table, the way many older sites were built, and it should read as plain prose."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Old pages also separate paragraphs with line breaks instead of paragraph tags."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The extractor splits those into real paragraphs."
        },
        {
          "type": "break"
        },
        {
          "type": "text",
          "text": "A single break stays a line break."
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Math"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Euler's identity "
        },
        {
          "type": "math",
          "tex": "e^{i\\pi}+1=0",
          "mathml": "<math alttext=\"e^{i\\pi}+1=0\"><mrow><msup><mi>e</mi><mrow><mi>i</mi><mi>π</mi></mrow></msup><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></mrow></math>",
          "text": "e^{i\\pi}+1=0"
        },
        {
          "type": "text",
          "text": " links five constants."
        }
      ]
    },
    {
      "type": "math",
      "tex": "a^2+b^2=c^2",
      "mathml": "<math display=\"block\"><semantics><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup><mo>=</mo><msup><mi>c</mi><mn>2</mn></msup></mrow></semantics></math>",
      "text": "a^2+b^2=c^2"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Words like HTML, “quoted speech”, H"
        },
        {
          "type": "text",
          "text": "2",
          "marks": [
            "sub"
          ]
        },
        {
          "type": "text",
          "text": "O, x"
        },
        {
