{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#000000",
    "bgPopup": "#101010",
    "bgMenu": "#1f1f1f",
    "fg": "#ededed",
    "muted": "#a1a1a1",
    "lineNumber": "#676767",
    "borderColor": "#1f1f1f",
    "blue": "#52a8ff",
    "green": "#62c073",
    "orange": "#ff9907",
    "purple": "#c472fb",
    "pink": "#f75f8f",
    "cyan": "#1da9b0",
    "diffAddFg": "#31603a",
    "diffDelFg": "#7c3048",
    "diffAddBg": "#0c170e",
    "diffDelBg": "#1e0b11"
  },
  "theme": {
    "primary": {
      "dark": "blue",
      "light": "blue"
    },
    "secondary": {
      "dark": "purple",
      "light": "purple"
    },
    "accent": {
      "dark": "green",
      "light": "green"
    },
    "error": {
      "dark": "pink",
      "light": "pink"
    },
    "warning": {
      "dark": "orange",
      "light": "orange"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "blue",
      "light": "blue"
    },
    "text": {
      "dark": "fg",
      "light": "fg"
    },
    "textMuted": {
      "dark": "muted",
      "light": "muted"
    },
    "background": {
      "dark": "bg",
      "light": "bg"
    },
    "backgroundPanel": {
      "dark": "bgPopup",
      "light": "bgPopup"
    },
    "backgroundElement": {
      "dark": "bgMenu",
      "light": "bgMenu"
    },
    "border": {
      "dark": "borderColor",
      "light": "borderColor"
    },
    "borderActive": {
      "dark": "lineNumber",
      "light": "lineNumber"
    },
    "borderSubtle": {
      "dark": "bgPopup",
      "light": "bgPopup"
    },
    "diffAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffRemoved": {
      "dark": "pink",
      "light": "pink"
    },
    "diffContext": {
      "dark": "muted",
      "light": "muted"
    },
    "diffHunkHeader": {
      "dark": "lineNumber",
      "light": "lineNumber"
    },
    "diffHighlightAdded": {
      "dark": "diffAddFg",
      "light": "diffAddFg"
    },
    "diffHighlightRemoved": {
      "dark": "diffDelFg",
      "light": "diffDelFg"
    },
    "diffAddedBg": {
      "dark": "diffAddBg",
      "light": "diffAddBg"
    },
    "diffRemovedBg": {
      "dark": "diffDelBg",
      "light": "diffDelBg"
    },
    "diffContextBg": {
      "dark": "bgPopup",
      "light": "bgPopup"
    },
    "diffLineNumber": {
      "dark": "lineNumber",
      "light": "lineNumber"
    },
    "diffAddedLineNumberBg": {
      "dark": "diffAddBg",
      "light": "diffAddBg"
    },
    "diffRemovedLineNumberBg": {
      "dark": "diffDelBg",
      "light": "diffDelBg"
    },
    "markdownText": {
      "dark": "fg",
      "light": "fg"
    },
    "markdownHeading": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownLink": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownLinkText": {
      "dark": "purple",
      "light": "purple"
    },
    "markdownCode": {
      "dark": "green",
      "light": "green"
    },
    "markdownBlockQuote": {
      "dark": "muted",
      "light": "muted"
    },
    "markdownEmph": {
      "dark": "orange",
      "light": "orange"
    },
    "markdownStrong": {
      "dark": "orange",
      "light": "orange"
    },
    "markdownHorizontalRule": {
      "dark": "borderColor",
      "light": "borderColor"
    },
    "markdownListItem": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownListEnumeration": {
      "dark": "purple",
      "light": "purple"
    },
    "markdownImage": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownImageText": {
      "dark": "purple",
      "light": "purple"
    },
    "markdownCodeBlock": {
      "dark": "fg",
      "light": "fg"
    },
    "syntaxComment": {
      "dark": "muted",
      "light": "muted"
    },
    "syntaxKeyword": {
      "dark": "pink",
      "light": "pink"
    },
    "syntaxFunction": {
      "dark": "purple",
      "light": "purple"
    },
    "syntaxVariable": {
      "dark": "blue",
      "light": "blue"
    },
    "syntaxString": {
      "dark": "green",
      "light": "green"
    },
    "syntaxNumber": {
      "dark": "orange",
      "light": "orange"
    },
    "syntaxType": {
      "dark": "cyan",
      "light": "cyan"
    },
    "syntaxOperator": {
      "dark": "pink",
      "light": "pink"
    },
    "syntaxPunctuation": {
      "dark": "fg",
      "light": "fg"
    }
  }
}
